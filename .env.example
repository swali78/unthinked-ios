# Unthinked AI assistant
# Without a key the chat runs an offline assistant over the mock data.
# Get a key at https://vercel.com/ai-gateway (or run `vercel env pull` on a linked project).
AI_GATEWAY_API_KEY=

# Optional: override the model (AI Gateway "provider/model" string)
# UNTHINKED_MODEL=anthropic/claude-sonnet-5.5

# Optional: force the offline assistant even when a key is set
# UNTHINKED_MOCK_AI=1

# Backend database
# Postgres connection string for production (Neon, Supabase, RDS, Vercel Postgres).
# Leave unset locally: the app uses an embedded Postgres in .data/pglite.
DATABASE_URL=

# Max connections per server instance when DATABASE_URL is set.
DATABASE_POOL_MAX=5

# Where the embedded database lives when DATABASE_URL is unset. "memory://" keeps it in memory.
PGLITE_DIR=

# Set to 0 to turn off the demo travelers, auto-replies and the starter group trip.
UNTHINKED_DEMO=1

# Moderation
# Comma-separated emails of accounts that can review reports at /admin/reports.
UNTHINKED_ADMIN_EMAILS=
# Optional: Slack or Discord (append /slack) incoming webhook, pinged on every new report.
MODERATION_WEBHOOK_URL=
# Public URL of the app, used for the review link in report notifications.
UNTHINKED_PUBLIC_URL=
