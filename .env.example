# Unthinked AI assistant
# Without a key the chat runs an offline assistant over the mock data.
# Get a key at https://vercel.com/ai-gateway (or run `vercel env pull` on a linked project).
AI_GATEWAY_API_KEY=

# Optional: override the model (AI Gateway "provider/model" string)
# UNTHINKED_MODEL=anthropic/claude-sonnet-5.5

# Optional: force the offline assistant even when a key is set
# UNTHINKED_MOCK_AI=1
